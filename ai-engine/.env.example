# Backend Express
BACKEND_URL=http://localhost:3001

# Cada cuánto analiza (segundos)
POLL_INTERVAL_SEC=60

# Cooldown entre alertas repetidas del mismo tipo (segundos)
ALERT_COOLDOWN_SEC=1800

# Riego automático por decisión de IA (1 = activo)
AI_IRRIGATION_ENABLED=0

# Claude API (opcional). Sin key, las recomendaciones usan un fallback por reglas
# y el análisis de fotos queda inactivo (no hay forma de mirar una foto sin modelo).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Análisis de fotos con visión (1 = activo)
PHOTO_ANALYSIS_ENABLED=1
# Cada cuánto se analiza UNA foto. Es la perilla de costo: con 3600 son ~24
# análisis por día; las fotos intermedias se descartan.
PHOTO_ANALYSIS_INTERVAL_SEC=3600
# Cuánto espera antes de volver a tomar una foto que quedó a medio analizar.
PHOTO_ANALYSIS_STALE_SEC=900
