generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SENSORES
// ============================================

enum SensorType {
  humidity_soil
  humidity_air
  temperature // usar tambien para temperatura del agua (hidroponia)
  light
  ph
  water_level // nivel del tanque en % (0-100)
  ec // conductividad electrica / nutrientes en mS/cm
}

enum SensorStatus {
  normal
  warning
  critical
  offline
}

model Sensor {
  id         String       @id @default(cuid())
  name       String
  type       SensorType
  unit       String
  status     SensorStatus @default(normal)
  lastValue  Float?
  lastUpdate DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  readings SensorReading[]
  crops    CropSensor[]

  @@map("sensors")
}

model SensorReading {
  id        String   @id @default(cuid())
  sensorId  String
  value     Float
  timestamp DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, timestamp])
  @@map("sensor_readings")
}

// Calibracion global por parametro (ej. "ph", "ec"). Los valores se
// editan desde la web y se copian al config.h del firmware.
model Calibration {
  id        String   @id @default(cuid())
  key       String   @unique // "ph" | "ec"
  params    Json // { voltageAt7, voltageAt4 } o { kValue }
  note      String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("calibrations")
}

// ============================================
// CULTIVOS
// ============================================

enum GrowthStage {
  germination
  seedling
  vegetative
  flowering
  fruiting
  harvest
}

model Crop {
  id                  String      @id @default(cuid())
  name                String
  variety             String
  plantedDate         DateTime
  expectedHarvestDate DateTime
  currentStage        GrowthStage @default(germination)
  healthScore         Int         @default(100)
  location            String
  imageUrl            String?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  sensors CropSensor[]
  alerts  Alert[]
  photos  Photo[]
  cameras Camera[]

  @@map("crops")
}

model CropSensor {
  id       String @id @default(cuid())
  cropId   String
  sensorId String

  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@unique([cropId, sensorId])
  @@map("crop_sensors")
}

// ============================================
// ALERTAS
// ============================================

enum AlertType {
  pest
  disease
  irrigation
  nutrition
  environmental
  growth
}

enum AlertSeverity {
  low
  medium
  high
  critical
}

model Alert {
  id               String        @id @default(cuid())
  type             AlertType
  severity         AlertSeverity
  title            String
  message          String
  isRead           Boolean       @default(false)
  aiRecommendation String?
  cropId           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([isRead, severity])
  @@map("alerts")
}

// ============================================
// FOTOS Y ANALISIS IA
// ============================================

enum PhotoSource {
  manual
  camera
}

enum AnalysisStatus {
  pending
  processing
  done
  failed
  skipped
}

model Photo {
  id           String   @id @default(cuid())
  url          String
  thumbnailUrl String?
  // Opcional desde que existe la ingesta por cámara: una cámara puede estar
  // apuntando a la huerta sin estar asociada a un cultivo concreto.
  cropId       String?
  capturedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  source PhotoSource @default(manual)

  // --- sólo para fotos ingestadas por cámara ---
  cameraId    String?
  storageKey  String? @unique // ruta del objeto en el storage
  sizeBytes   Int?
  width       Int?
  height      Int?
  contentHash String? // sha256 del JPEG, en hex

  // Clave de deduplicación: hace idempotente el POST de ingesta ante reintentos.
  // Ver buildDedupeKey() en src/services/ingest.ts.
  dedupeKey String? @unique

  analysisStatus AnalysisStatus @default(pending)
  // Cuándo un worker tomó la foto para analizarla. Sirve para recuperar las
  // que quedaron en `processing` porque el worker se murió a mitad de camino.
  analysisStartedAt DateTime?
  // Motivo del último fallo, para poder diagnosticar sin mirar los logs.
  analysisError     String?

  // Título que se le pone desde la web. Las fotos de cámara llegan sin uno.
  title String?

  crop     Crop?          @relation(fields: [cropId], references: [id], onDelete: SetNull)
  camera   Camera?        @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  analysis PhotoAnalysis?
  comments PhotoComment[]

  @@index([cameraId, capturedAt])
  @@index([analysisStatus])
  @@map("photos")
}

model Camera {
  id                 String    @id // identificador del dispositivo, ej. "esp32-cam-01"
  name               String?
  cropId             String?
  // El dispositivo lo consulta en GET /api/cameras/:id/config. En false deja
  // de sacar fotos pero sigue preguntando, así se lo puede despausar.
  isActive           Boolean   @default(true)
  // Cada cuánto saca una foto. Se edita desde la web, sin reflashear.
  captureIntervalSec Int       @default(60)
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  crop   Crop?   @relation(fields: [cropId], references: [id], onDelete: SetNull)
  photos Photo[]

  @@map("cameras")
}

// Notas que se escriben desde la web sobre una foto: "acá se ve la mancha",
// "el brote nuevo salió". Todavía no hay usuarios, así que el autor es texto.
model PhotoComment {
  id        String   @id @default(cuid())
  photoId   String
  body      String
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId, createdAt])
  @@map("photo_comments")
}

model PhotoAnalysis {
  id              String   @id @default(cuid())
  photoId         String   @unique
  healthScore     Int
  growthStage     String
  issues          String[] @default([])
  recommendations String[] @default([])
  analyzedAt      DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@map("photo_analyses")
}

// ============================================
// RIEGO
// ============================================

enum IrrigationTrigger {
  scheduled
  ai_decision
  manual
}

model IrrigationZone {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  events IrrigationEventZone[]

  @@map("irrigation_zones")
}

model IrrigationEvent {
  id          String            @id @default(cuid())
  trigger     IrrigationTrigger
  duration    Int // minutos
  waterVolume Float // litros
  startedAt   DateTime          @default(now())
  endedAt     DateTime?
  createdAt   DateTime          @default(now())

  zones IrrigationEventZone[]

  @@index([startedAt])
  @@map("irrigation_events")
}

model IrrigationEventZone {
  id      String @id @default(cuid())
  eventId String
  zoneId  String

  event IrrigationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zone  IrrigationZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([eventId, zoneId])
  @@map("irrigation_event_zones")
}

// Riego programado por horario. Lo ejecuta el scheduler del backend
// (services/scheduler.ts) respetando el chequeo de nivel del tanque.
model IrrigationSchedule {
  id        String    @id @default(cuid())
  name      String
  time      String // "HH:MM" (24h, hora local del server)
  duration  Int // minutos
  days      Int[] // 0-6 (dom..sab); vacío = todos los días
  zoneIds   String[] // ids de zonas a regar
  enabled   Boolean   @default(true)
  lastRun   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("irrigation_schedules")
}

// ============================================
// USUARIOS (para autenticación futura)
// ============================================

enum UserRole {
  admin
  user
  viewer
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(user)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
