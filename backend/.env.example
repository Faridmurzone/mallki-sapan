# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mallki_sapan?schema=public"

# Server
PORT=3001
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:3000

# Ingesta de imágenes desde las cámaras
# Directorio del driver de storage local (relativo al cwd del backend).
STORAGE_DIR=./storage
# Base pública desde la que se sirven las imágenes guardadas. En producción,
# la URL del bucket o del reverse proxy.
PUBLIC_BASE_URL=http://localhost:3001
# Tamaño máximo por imagen, en bytes. Por defecto 2 MB.
MAX_IMAGE_BYTES=2097152
# Alta automática de cámaras desconocidas. Ponelo en false cuando la ingesta
# tenga autenticación por dispositivo: ahí una cámara sin registrar debe fallar.
CAMERA_AUTOREGISTER=true
